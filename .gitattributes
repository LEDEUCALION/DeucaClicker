# Normalise les fins de ligne au commit ; restitue le format natif au checkout.
* text=auto

*.c      text diff=cpp
*.cpp    text diff=cpp
*.h      text diff=cpp
*.hpp    text diff=cpp
*.cmake  text
*.md     text diff=markdown
*.json   text
*.yml    text

# Visual Studio exige du CRLF sur ces fichiers.
*.sln    text eol=crlf
*.vcxproj text eol=crlf

*.png    binary
*.ico    binary
*.ttf    binary
