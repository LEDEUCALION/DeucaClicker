# Le style Microsoft est celui qui colle le mieux au code Win32 sur lequel
# ce projet est bâti.
BasedOnStyle: Microsoft
Standard: c++20
ColumnLimit: 110
IndentWidth: 4
# Aligne public: et private: sur le mot-clé class plutôt que de les rentrer
# de deux espaces, ce qui est la valeur héritée et ne ressemble à rien.
AccessModifierOffset: -4
PointerAlignment: Left
ReferenceAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
SeparateDefinitionBlocks: Always
SortIncludes: CaseInsensitive
IncludeBlocks: Regroup
IncludeCategories:
  # WindowsLean d'abord : il pose WIN32_LEAN_AND_MEAN et NOMINMAX avant que
  # quoi que ce soit d'autre ne puisse tirer <Windows.h> dans son dos.
  - Regex: '^"platform/WindowsLean\.hpp"'
    Priority: 1
  # Puis nos en-têtes, les bibliothèques tierces, le SDK Windows, et enfin
  # la bibliothèque standard.
  - Regex: '^"(core|platform|ui|engine)/'
    Priority: 2
  - Regex: '^<(imgui|catch2)'
    Priority: 3
  - Regex: '^<(d3d|dxgi|wrl|Windows)'
    Priority: 4
  - Regex: '^<'
    Priority: 5
